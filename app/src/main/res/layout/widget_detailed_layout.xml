<?xml version="1.0" encoding="utf-8"?>
<!--
  Detailed Usage widget — dark-only, high-density, readable layout.
  No charts: the cost trend is intentionally absent (open the Platform Usage page for charts).
  Vertical budget is tuned for 4×5; 4×4 may clip the bottom block by design.

  includeFontPadding=false everywhere so a larger textSize costs less vertical space.
  Every colour is a semantic resource (colors.xml) — no hex literals here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailed_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_detailed_bg">

    <!-- Header: title (→ open portal) · updated time · refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_d_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DeepSeek Usage"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_dark_text_primary"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_d_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="12sp"
            android:textColor="@color/widget_dark_text_tertiary"
            android:includeFontPadding="false"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/iv_d_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_refresh_dark"
            android:contentDescription="refresh" />
    </LinearLayout>

    <!-- Hidden (GONE) unless there is a status/error to show -->
    <TextView
        android:id="@+id/tv_d_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/widget_dark_text_tertiary"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_dark_divider"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp" />

    <!-- Account block: Topped-up balance · Total cost (eyes toggle) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALANCE"
                android:textSize="12sp"
                android:textColor="@color/widget_dark_text_secondary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_d_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥--"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_accent"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL COST"
                    android:textSize="12sp"
                    android:textColor="@color/widget_dark_text_secondary"
                    android:includeFontPadding="false" />

                <ImageView
                    android:id="@+id/iv_d_eye"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_visibility_dark"
                    android:contentDescription="toggle total cost" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_d_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥••••••"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filters: TIME · API KEY (each cycles on tap, state is per-widget) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/row_d_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textSize="12sp"
                android:textColor="@color/widget_dark_text_tertiary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_d_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last 7 days"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_d_key"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API KEY"
                android:textSize="12sp"
                android:textColor="@color/widget_dark_text_tertiary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_d_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Keys"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filtered metrics (official): COST · REQUESTS · TOKENS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COST"
                android:textSize="12sp"
                android:textColor="@color/widget_dark_text_tertiary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_d_cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¥--"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_accent"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQUESTS"
                android:textSize="12sp"
                android:textColor="@color/widget_dark_text_tertiary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_d_requests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOKENS"
                android:textSize="12sp"
                android:textColor="@color/widget_dark_text_tertiary"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tv_d_tokens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_dark_divider"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CACHE / BILLING"
        android:textSize="12sp"
        android:textColor="@color/widget_dark_text_tertiary"
        android:includeFontPadding="false" />

    <!-- CACHE HIT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CACHE HIT"
            android:textSize="13sp"
            android:textColor="@color/widget_dark_text_secondary"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_d_hit_tok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:gravity="start"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_d_hit_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textSize="15sp"
                android:textColor="@color/widget_dark_text_secondary"
                android:includeFontPadding="false"
                android:gravity="center"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_d_hit_cost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="--"
                android:textSize="16sp"
                android:textColor="@color/widget_dark_text_secondary"
                android:includeFontPadding="false"
                android:gravity="end"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- CACHE MISS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CACHE MISS"
            android:textSize="13sp"
            android:textColor="@color/widget_dark_text_secondary"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_d_miss_tok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:gravity="start"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_d_miss_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textSize="15sp"
                android:textColor="@color/widget_dark_text_secondary"
                android:includeFontPadding="false"
                android:gravity="center"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_d_miss_cost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="--"
                android:textSize="16sp"
                android:textColor="@color/widget_dark_text_secondary"
                android:includeFontPadding="false"
                android:gravity="end"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- OUTPUT (no percentage: its denominator would differ from the hit/miss input share) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTPUT"
            android:textSize="13sp"
            android:textColor="@color/widget_dark_text_secondary"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_d_out_tok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_dark_text_primary"
                android:includeFontPadding="false"
                android:gravity="start"
                android:singleLine="true" />

            <!-- Alignment spacer only — no invented OUTPUT percentage -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_d_out_cost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="--"
                android:textSize="16sp"
                android:textColor="@color/widget_dark_text_secondary"
                android:includeFontPadding="false"
                android:gravity="end"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- EST. CACHE SAVINGS (counterfactual estimate: hit tokens priced at the miss rate) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EST. CACHE SAVINGS"
            android:textSize="13sp"
            android:textColor="@color/widget_dark_text_tertiary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tv_d_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_dark_text_primary"
            android:includeFontPadding="false"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
